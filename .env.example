# Example environment configuration for langchain-codex-oauth
#
# Copy to `.env` (which is gitignored) and adjust as needed.
# This project never requires OPENAI_API_KEY.

# Root directory for local state (auth + instructions cache)
# Default: $HOME/.langchain-codex-oauth
LANGCHAIN_CODEX_OAUTH_HOME=

# Override full path to the auth JSON file
# Default: $LANGCHAIN_CODEX_OAUTH_HOME/auth/openai.json
# (If LANGCHAIN_CODEX_OAUTH_HOME is unset, default resolves to
#  $HOME/.langchain-codex-oauth/auth/openai.json)
LANGCHAIN_CODEX_OAUTH_AUTH_PATH=

# Control how Codex `instructions` are resolved.
# Default: auto
# Accepted: auto | cache | github | bundled
#
# - auto: use cache if present; else try GitHub; else use bundled fallback
# - cache: only use local cache (error if missing)
# - github: always fetch from GitHub (error if unavailable)
# - bundled: always use the bundled prompt shipped in the wheel
LANGCHAIN_CODEX_OAUTH_INSTRUCTIONS_MODE=auto

# Enable request logging for the local OAuth callback server.
# Default: unset
# Accepted: any non-empty value (e.g., 1, true)
LANGCHAIN_CODEX_OAUTH_DEBUG=

# --- Optional HTTP/runtime defaults ---
# These are optional defaults used when you do not pass the equivalent
# constructor args to `ChatCodexOAuth(...)`.

# Override the ChatGPT/Codex backend base URL.
# Default: https://chatgpt.com/backend-api
LANGCHAIN_CODEX_OAUTH_BASE_URL=https://chatgpt.com/backend-api

# Default request timeout in seconds (float).
# Default: 60
LANGCHAIN_CODEX_OAUTH_TIMEOUT_S=60

# Default max retries for transient errors (429/5xx/network timeouts).
# Default: 2
LANGCHAIN_CODEX_OAUTH_MAX_RETRIES=2

# Default generation temperature (float; best-effort passthrough).
# Default: unset
# Typical range: 0.0 to 2.0
LANGCHAIN_CODEX_OAUTH_TEMPERATURE=

# Default max tokens (int; best-effort passthrough).
# Default: unset
# Sent to the backend as `max_output_tokens`.
LANGCHAIN_CODEX_OAUTH_MAX_TOKENS=
