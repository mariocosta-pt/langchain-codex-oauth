# Example environment configuration for langchain-codex-oauth
#
# Copy to `.env` (which is gitignored) and adjust as needed.
# This project never requires OPENAI_API_KEY.

# Root directory for local state (auth/cache/logs)
# Default: $HOME/.langchain-codex-oauth
LANGCHAIN_CODEX_OAUTH_HOME=

# Override full path to the auth JSON file
# Default: $LANGCHAIN_CODEX_OAUTH_HOME/auth/openai.json
LANGCHAIN_CODEX_OAUTH_AUTH_PATH=

# Control how Codex `instructions` are resolved.
# Default: auto
# Accepted: auto | cache | github | bundled
#
# - auto: use cache if present; else try GitHub; else use bundled fallback
# - cache: only use local cache (error if missing)
# - github: always fetch from GitHub (error if unavailable)
# - bundled: always use the bundled prompt shipped in the wheel
LANGCHAIN_CODEX_OAUTH_INSTRUCTIONS_MODE=auto

# Enable extra debug output for the local OAuth callback server.
# Default: unset
# Accepted: any non-empty value (e.g., 1, true)
LANGCHAIN_CODEX_OAUTH_DEBUG=
